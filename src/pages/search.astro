---
import BaseLayout from "../layouts/BaseLayout.astro";

const frontmatter = {
  pageTitle: "Search - Steve Klabnik",
  description: "Search Steve Klabnik's blog posts",
};
---

<BaseLayout frontmatter={frontmatter}>
  {/* Keep the search page itself out of the index. */}
  <div data-pagefind-ignore>
    <h1 class="text-3xl font-bold mb-4">Search</h1>
    <p class="text-secondary mb-6">
      Full text of every post, back to 2009.
    </p>

    <form
      id="search-form"
      role="search"
      class="mb-8"
      action="/search"
      method="get"
    >
      <label for="search-input" class="sr-only">Search posts</label>
      <input
        id="search-input"
        name="q"
        type="search"
        autocomplete="off"
        autofocus
        placeholder="borrow checker, hypermedia, Deleuze&hellip;"
        class="w-full px-4 py-2 rounded-md border border-base bg-surface text-primary placeholder:text-muted"
      />
      <noscript>
        <button
          type="submit"
          class="mt-2 px-4 py-2 rounded-md border border-base bg-surface"
          >Search</button
        >
        <p class="mt-4 text-secondary">
          Search needs JavaScript. Without it, the <a href="/writing"
            >full archive</a
          > is one page you can search with your browser's find.
        </p>
      </noscript>
    </form>

    <p id="search-status" class="text-secondary" aria-live="polite"></p>
    <ul id="search-results" class="space-y-6 list-none"></ul>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.getElementById("search-form");
    const input = document.getElementById("search-input");
    const status = document.getElementById("search-status");
    const list = document.getElementById("search-results");

    // pagefind.js is generated from dist/ after astro build, so it can't be
    // resolved by the bundler — this script is is:inline for that reason,
    // and the module is imported at runtime.
    let pagefind;
    let loadFailed = false;

    async function ensurePagefind() {
      if (pagefind || loadFailed) return pagefind;
      try {
        pagefind = await import("/pagefind/pagefind.js");
        await pagefind.options({ excerptLength: 30 });
      } catch {
        loadFailed = true;
        status.textContent =
          "Search index isn't available here — it's generated by a production build.";
      }
      return pagefind;
    }

    function render(results, total, query) {
      list.replaceChildren();

      for (const result of results) {
        const item = document.createElement("li");
        item.className = "pl-6 relative";

        const dot = document.createElement("span");
        dot.className =
          "absolute left-0 top-2 w-2 h-2 bg-accent-muted rounded-full";

        const link = document.createElement("a");
        link.href = result.url;
        link.className = "text-accent hover:text-accent-hover font-medium";
        link.textContent = result.meta.title ?? result.url;

        const excerpt = document.createElement("p");
        excerpt.className = "text-sm text-secondary mt-1";
        // Pagefind marks the matched terms with <mark>.
        excerpt.innerHTML = result.excerpt;

        item.append(dot, link, excerpt);

        if (result.meta.date) {
          const time = document.createElement("time");
          time.className = "block text-sm text-muted mt-1";
          time.textContent = result.meta.date;
          item.append(time);
        }

        list.append(item);
      }

      const shown = results.length;
      status.textContent =
        total === 0
          ? `No posts match “${query}”.`
          : `${total} post${total === 1 ? "" : "s"} match “${query}”${
              shown < total ? ` — showing the first ${shown}` : ""
            }.`;
    }

    async function run(query) {
      if (!query) {
        list.replaceChildren();
        status.textContent = "";
        return;
      }

      const engine = await ensurePagefind();
      if (!engine) return;

      status.textContent = "Searching…";
      const search = await engine.search(query);
      const results = await Promise.all(
        search.results.slice(0, 20).map((result) => result.data()),
      );

      // A slower search that has since been superseded shouldn't overwrite
      // the newer one's results.
      if (input.value.trim() !== query) return;

      render(results, search.results.length, query);
    }

    let timer;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      const query = input.value.trim();
      timer = setTimeout(() => {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set("q", query);
        else url.searchParams.delete("q");
        window.history.replaceState({}, "", url);
        run(query);
      }, 150);
    });

    // Submitting is a no-op: results are already on the page.
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      run(input.value.trim());
    });

    // Warm the index on focus so the first keystroke isn't the slow one.
    input.addEventListener("focus", ensurePagefind, { once: true });

    const initial = new URLSearchParams(window.location.search).get("q");
    if (initial) {
      input.value = initial;
      run(initial);
    }
  })();
</script>
