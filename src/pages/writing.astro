---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { buildSeriesData, getSeriesMetadata } from "../utils/series.ts";
import { getTopicMetadata } from "../utils/topics.ts";
import DevCreateButton from "../components/editor/DevCreateButton";
const pageTitle = "Steve Klabnik's Blog";
const allPosts = await getCollection("blog");

// Build series data to add indicators
const seriesData = buildSeriesData(allPosts);
const seriesMetadataMap = new Map();
seriesData.forEach((_, slug) => {
  const metadata = getSeriesMetadata(slug);
  if (metadata) {
    seriesMetadataMap.set(slug, metadata);
  }
});

let allPostsByDate = (() => {
  let posts: Record<string, Array<CollectionEntry<"blog">>> = {};
  allPosts.map((post) => {
    let year = new Date(post.data.pubDate).getFullYear();
    let array = posts[year.toString()];

    // if this is the first post of this year, we have to create the inner array
    if (!array || !array.length) {
      posts[year.toString()] = [];
    }

    posts[year.toString()].push(post);
  });

  for (const value of Object.values(posts)) {
    value.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  }

  return posts;
})();

const years = Object.keys(allPostsByDate).reverse();
const frontmatter = {
  pageTitle: pageTitle,
  description: "Steve Klabnik's blog posts on programming, technology, and software development"
};

---

<BaseLayout frontmatter={frontmatter}>
  <div class="max-w-none">
    <h1 class="text-3xl font-bold mb-8">This is my blog.</h1>
    {
      years.map((year) => (
        <section class="mb-8">
          <h2 class="text-2xl font-semibold mb-4 mt-8 first:mt-0">{year}</h2>
          <ul class="space-y-2 list-none">
            {allPostsByDate[year].map((post) => {
              const series = post.data.series?.slug ? seriesMetadataMap.get(post.data.series.slug) : null;
              const topicMeta = post.data.topic ? getTopicMetadata(post.data.topic) : null;
              return (
                <li class="pl-6 relative">
                  <span class="absolute left-0 top-2 w-2 h-2 bg-accent-muted rounded-full"></span>
                  <a href={`/writing/${post.id.replace(/^\d{4}-\d{2}\//, '')}/`} class="text-accent hover:text-accent-hover visited:text-accent-visited font-medium">
                    {post.data.title}
                  </a>
                  {series && post.data.series && (
                    <span class="ml-2">
                      <a
                        href={`/series/${post.data.series.slug}`}
                        class="series-badge text-xs bg-accent-light text-accent px-2 py-1 rounded hover:bg-accent-light-hover transition-colors"
                      >
                        {series.title}
                      </a>
                    </span>
                  )}
                  {topicMeta && post.data.topic && (
                    <span class="ml-2">
                      <a
                        href={`/topics/${post.data.topic}/`}
                        class="topic-badge text-xs bg-accent-light text-accent px-2 py-1 rounded hover:bg-accent-light-hover transition-colors"
                      >
                        {topicMeta.title}
                      </a>
                    </span>
                  )}
                  <time class="block text-sm text-secondary mt-1">
                    {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
                  </time>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
  <DevCreateButton client:only="react" type="post" />
</BaseLayout>
