---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { noteSlug } from "../../utils/notes";
import DevCreateButton from "../../components/editor/DevCreateButton";

const pageTitle = "Notes";
const allNotes = await getCollection("notes");

// Sort by lastUpdated (most recent first), then alphabetically by title
allNotes.sort((a, b) => {
  const aDate = a.data.lastUpdated?.getTime() ?? 0;
  const bDate = b.data.lastUpdated?.getTime() ?? 0;
  if (aDate !== bDate) return bDate - aDate;
  return a.data.title.localeCompare(b.data.title);
});

const frontmatter = {
  pageTitle,
  description: "Steve Klabnik's notes — interconnected, living documents on various topics",
};
---

<BaseLayout frontmatter={frontmatter}>
  <div class="max-w-none">
    <h1 class="text-3xl font-bold mb-4">Notes</h1>
    <p class="text-gray-600 mb-8">
      Interconnected, living documents. Unlike blog posts, these get updated
      over time as my understanding evolves.
    </p>
    <ul class="space-y-2 list-none">
      {allNotes.map((note) => (
        <li class="pl-6 relative">
          <span class="absolute left-0 top-2 w-2 h-2 bg-gray-400 rounded-full"></span>
          <a
            href={`/notes/${noteSlug(note.id)}/`}
            class="text-purple-600 hover:text-purple-800 visited:text-purple-900 font-medium"
          >
            {note.data.title}
          </a>
          {note.data.lastUpdated && (
            <time class="block text-sm text-gray-600 mt-1">
              Updated {note.data.lastUpdated.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
                timeZone: "UTC",
              })}
            </time>
          )}
        </li>
      ))}
    </ul>
  </div>
  <DevCreateButton client:only="react" type="note" />
</BaseLayout>
