---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildBacklinks, noteSlug } from "../../utils/notes";
import type { Backlink } from "../../utils/notes";

export async function getStaticPaths() {
  const allNotes = await getCollection("notes");
  const backlinkMap = buildBacklinks(allNotes);

  return allNotes.map((entry) => ({
    params: { slug: noteSlug(entry.id) },
    props: {
      entry,
      backlinks: backlinkMap.get(noteSlug(entry.id)) ?? [],
    },
  }));
}

const { entry, backlinks } = Astro.props as {
  entry: Awaited<ReturnType<typeof getCollection<"notes">>>[number];
  backlinks: Backlink[];
};

const { Content } = await entry.render();

const frontmatter = {
  pageTitle: entry.data.title,
  description: `Note: ${entry.data.title} by Steve Klabnik`,
};
---

<BaseLayout frontmatter={frontmatter}>
  <article class="prose prose-slate">
    <h1 class="mb-2">{entry.data.title}</h1>
    {entry.data.lastUpdated && (
      <p class="text-sm text-gray-600 mt-0">
        Last updated{" "}
        <time datetime={entry.data.lastUpdated.toISOString()}>
          {entry.data.lastUpdated.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
            timeZone: "UTC",
          })}
        </time>
      </p>
    )}
    <Content />
  </article>

  {backlinks.length > 0 && (
    <aside class="mt-12 pt-8 border-t border-gray-200">
      <h2 class="text-lg font-semibold text-gray-700 mb-3">Linked from</h2>
      <ul class="space-y-1 list-none">
        {backlinks.map((bl) => (
          <li class="pl-6 relative">
            <span class="absolute left-0 top-2 w-2 h-2 bg-gray-400 rounded-full"></span>
            <a
              href={`/notes/${bl.slug}/`}
              class="text-purple-600 hover:text-purple-800"
            >
              {bl.title}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )}
</BaseLayout>
