---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildBacklinks, getNotes, noteSlug } from "../../utils/notes";
import type { Backlink } from "../../utils/notes";
import { formatDate } from "../../utils/posts";
import DevEditorToggle from "../../components/editor/DevEditorToggle";

export async function getStaticPaths() {
  const allNotes = await getNotes();
  const backlinkMap = buildBacklinks(allNotes);

  return allNotes.map((entry) => ({
    params: { slug: noteSlug(entry.id) },
    props: {
      entry,
      backlinks: backlinkMap.get(noteSlug(entry.id)) ?? [],
    },
  }));
}

const { entry, backlinks } = Astro.props as {
  entry: CollectionEntry<"notes">;
  backlinks: Backlink[];
};

const { Content } = await render(entry);

const frontmatter = {
  pageTitle: entry.data.title,
  description: `Note: ${entry.data.title} by Steve Klabnik`,
};

const currentSlug = noteSlug(entry.id);
---

<BaseLayout frontmatter={frontmatter} section="notes">
  <article class="prose prose-slate dark:prose-invert">
    <h1 class="mb-2">{entry.data.title}</h1>
    {entry.data.lastUpdated && (
      <p class="text-sm text-secondary mt-0">
        Last updated{" "}
        <time datetime={entry.data.lastUpdated.toISOString()}>
          {formatDate(entry.data.lastUpdated)}
        </time>
      </p>
    )}
    <Content />
  </article>

  {backlinks.length > 0 && (
    <aside class="mt-12 pt-8 border-t border-base">
      <h2 class="text-lg font-semibold text-secondary mb-3">Linked from</h2>
      <ul class="space-y-1 list-none">
        {backlinks.map((bl) => (
          <li class="pl-6 relative">
            <span class="absolute left-0 top-2 w-2 h-2 bg-accent-muted rounded-full"></span>
            <a
              href={`/notes/${bl.slug}/`}
              class="text-accent hover:text-accent-hover"
            >
              {bl.title}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )}
  {
    // client:only islands ship the React runtime even when the component
    // renders null, so only emit the island at all in dev builds.
    import.meta.env.DEV && (
      <DevEditorToggle client:only="react" type="note" slug={currentSlug} />
    )
  }
</BaseLayout>
