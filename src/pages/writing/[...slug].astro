---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeriesNavigationComponent from "../../components/SeriesNavigation.astro";
import PostNavigation from "../../components/PostNavigation.astro";
import { buildSeriesData, getSeriesNavigation } from "../../utils/series";
import type { SeriesNavigation } from "../../utils/series.ts";
import { getTopicMetadata } from "../../utils/topics.ts";
import { formatDate, getAdjacentPosts, postSlug } from "../../utils/posts.ts";
import { postDescription } from "../../utils/rendered.ts";
import { documentAtUri } from "../../data/standardSite";
import DevEditorToggle from "../../components/editor/DevEditorToggle";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: postSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allPosts = await getCollection("blog");

// Build series data if this post is part of a series
let seriesNavigation: SeriesNavigation | null = null;

if (entry.data.series?.slug) {
  const seriesData = buildSeriesData(allPosts);
  seriesNavigation = getSeriesNavigation(entry, seriesData);
}

const adjacent = getAdjacentPosts(entry, allPosts);

const cleanSlug = postSlug(entry.id);

const frontmatter = {
  pageTitle: entry.data.title,
  description: await postDescription(entry),
  ogImage: `/og/writing/${cleanSlug}.png`,
  pubDate: entry.data.pubDate,
  // Standard.site verification: ties this page to its AT Protocol record.
  documentAtUri: documentAtUri(cleanSlug, entry.data.pubDate),
};
---

<BaseLayout frontmatter={frontmatter}>
  <article class="prose prose-slate dark:prose-invert">
    <h1 class="mb-2">{entry.data.title}</h1>
    <time datetime={entry.data.pubDate.toISOString()} class="text-secondary">
      {formatDate(entry.data.pubDate)}
    </time>
    {entry.data.topic && getTopicMetadata(entry.data.topic) && (
      <div class="mt-2">
        <a
          href={`/topics/${entry.data.topic}/`}
          class="topic-badge text-sm px-3 py-1 rounded"
        >
          {getTopicMetadata(entry.data.topic)!.title}
        </a>
      </div>
    )}
    {seriesNavigation && <SeriesNavigationComponent seriesData={seriesNavigation} />}
    <Content />
    {seriesNavigation && <SeriesNavigationComponent seriesData={seriesNavigation} />}
  </article>
  <PostNavigation adjacent={adjacent} topic={entry.data.topic} />
  {
    // client:only islands ship the React runtime even when the component
    // renders null, so only emit the island at all in dev builds.
    import.meta.env.DEV && (
      <DevEditorToggle client:only="react" type="post" slug={cleanSlug} />
    )
  }
</BaseLayout>
