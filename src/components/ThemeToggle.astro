---
// Pure Astro component — vanilla JS, zero hydration cost
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="inline-flex items-center justify-center w-9 h-9 rounded-md transition-colors hover:bg-accent-light"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg
    id="theme-sun"
    class="hidden w-5 h-5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    ></path>
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg
    id="theme-moon"
    class="hidden w-5 h-5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    ></path>
  </svg>
  <!-- Monitor icon (shown in system mode) -->
  <svg
    id="theme-system"
    class="hidden w-5 h-5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
    ></path>
  </svg>
</button>

<script is:inline>
  function updateToggleIcons() {
    const stored = localStorage.getItem('theme');
    const sun = document.getElementById('theme-sun');
    const moon = document.getElementById('theme-moon');
    const system = document.getElementById('theme-system');
    const btn = document.getElementById('theme-toggle');

    // Determine which icon to show based on stored preference
    // 'light' → sun, 'dark' → moon, null (system) → monitor
    if (sun) sun.classList.toggle('hidden', stored !== 'light');
    if (moon) moon.classList.toggle('hidden', stored !== 'dark');
    if (system) system.classList.toggle('hidden', stored !== null);

    // Update aria-label
    if (btn) {
      const label = stored === 'dark' ? 'Dark' : stored === 'light' ? 'Light' : 'System';
      btn.setAttribute('aria-label', `Theme: ${label}`);
    }
  }

  function setupToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const stored = localStorage.getItem('theme');

      if (stored === 'light') {
        // Light → Dark
        localStorage.setItem('theme', 'dark');
        document.documentElement.classList.add('dark');
      } else if (stored === 'dark') {
        // Dark → System
        localStorage.removeItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', prefersDark);
      } else {
        // System → Light
        localStorage.setItem('theme', 'light');
        document.documentElement.classList.remove('dark');
      }

      updateToggleIcons();
    });
    updateToggleIcons();
  }

  // Run on initial load
  setupToggle();

  // Re-run after view transitions (ClientRouter swaps the DOM)
  document.addEventListener('astro:after-swap', () => {
    setupToggle();
  });
</script>
